{"is_source_file": true, "format": "JavaScript", "description": "This is a Node.js script used to detect whether the environment is a Continuous Integration (CI) environment or local development. It configures environment variables accordingly to prevent issues during automated builds or local development, especially involving the webpack dev server. It handles process spawning to start server processes, manages environment variables like HOST, PORT, NODE_OPTIONS, and controls whether to run a static build server or a development server.", "external_files": ["child_process"], "external_methods": ["require('child_process').spawnSync"], "published": [], "classes": [], "methods": [{"name": "isCI", "description": "Detects if the current environment is a CI environment based on environment variables."}, {"name": "run", "description": "Executes a command synchronously with given arguments, forwarding stdio, and exits the process with the command's exit code."}], "calls": ["spawnSync", "console.log", "process.platform", "process.env", "String", "RegExp.test", "process.exit"], "search-terms": ["CI environment detection", "start script", "webpack dev server", "static build serve", "environment variable management", "node process spawn", "CI environment overrides"], "state": 2, "file_id": 36, "knowledge_revision": 419, "git_revision": "5ef379c22b1b59fb8b147861e02cbcb559e3f161", "revision_history": [{"212": ""}, {"217": "b41a2c2069bc707f892cce840606ea15d47b287d"}, {"225": "de2b3b0c842461386278ba72731f661316357e75"}, {"233": "214044ebcdbcfcc4567597223abf9dc9b3d67ed3"}, {"240": "7db643b828bbd54aaac41fa7ecd35ec0248258f4"}, {"248": "7e985289cf2c6edef4ae24e507d902b6cce1fd78"}, {"262": "f450b652248317ea0079757a1228a1b18d20929c"}, {"272": "9bb279050381e5d3df901b7f16c9bd856b5b3577"}, {"297": "9dd7a0101743b8774082e4febae6163a75c375c9"}, {"300": "366f954b8faeaa6455b519cdbeeed5a689e7cf52"}, {"310": "f3fd40ddf4709844469dfeec24eff7f5758fde50"}, {"317": "e49287ccf7a84f2b594d2f6ce0e88d700782