{
  "name": "react-kavia",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.1",
    "react-scripts": "^5.0.1",
    "serve": "^14.2.3"
  },
  "scripts": {
    "start": "react-scripts start",
    "start:ci": "cross-env BROWSER=none CI=true HOST=${HOST:-0.0.0.0} PORT=${REACT_APP_PORT:-3000} GENERATE_SOURCEMAP=${REACT_APP_ENABLE_SOURCE_MAPS:-false} react-scripts start",
    "build": "react-scripts build",
    "build:ci": "cross-env CI=true GENERATE_SOURCEMAP=${REACT_APP_ENABLE_SOURCE_MAPS:-false} react-scripts build",
    "serve": "serve -s build -l ${REACT_APP_PORT:-3000}",
    "start:serve": "npm run build:ci && npm run serve",
    "ci": "npm run start:serve",
    "test": "react-scripts test --watchAll=false",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
