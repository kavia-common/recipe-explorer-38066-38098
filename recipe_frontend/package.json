{
  "name": "react-kavia",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.1",
    "react-scripts": "^5.0.1",
    "serve": "^14.2.3"
  },
  "scripts": {
    "start": "react-scripts start",
    "start:ci": "cross-env BROWSER=none CI=true HOST=${HOST:-0.0.0.0} PORT=${REACT_APP_PORT:-3000} GENERATE_SOURCEMAP=${REACT_APP_ENABLE_SOURCE_MAPS:-false} react-scripts start",
    "start:lowmem": "cross-env BROWSER=none CI=true NODE_OPTIONS=--max-old-space-size=256 HOST=${HOST:-0.0.0.0} PORT=${REACT_APP_PORT:-3000} GENERATE_SOURCEMAP=${REACT_APP_ENABLE_SOURCE_MAPS:-false} react-scripts start",
    "build": "react-scripts build",
    "build:ci": "cross-env CI=true GENERATE_SOURCEMAP=${REACT_APP_ENABLE_SOURCE_MAPS:-false} NODE_OPTIONS=--max-old-space-size=256 react-scripts build",
    "serve": "serve -s build -L -n -C --single -l ${REACT_APP_PORT:-3000}",
    "start:serve": "npm run build:ci && npm run serve",
    "ci": "npm run start:serve",
    "healthcheck": "node -e \"require('http').get('http://localhost:'+(process.env.REACT_APP_PORT||3000)+(process.env.REACT_APP_HEALTHCHECK_PATH||'/'),res=>{console.log('health',res.statusCode);process.exit(res.statusCode===200?0:1)}).on('error',()=>process.exit(1))\"",
    "test": "react-scripts test --watchAll=false",
    "postinstall": "npx -y update-browserslist-db@latest || true",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
