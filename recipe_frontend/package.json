{
  "name": "react-kavia",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.1",
    "react-scripts": "^5.0.1",
    "serve": "^14.2.3",
    "cross-env": "^7.0.3"
  },
  "scripts": {
    "start": "node -e \"const {spawnSync}=require('child_process');const isCI=String(process.env.CI).toLowerCase()==='true';if(isCI){console.log('[recipe_frontend] CI detected: running start:serve to avoid exit code 137.');process.exit(123);}else{const r=spawnSync('npm',['run','_start:dev'],{stdio:'inherit',shell:true});process.exit(r.status||0);}\"; exitCode=$?; if [ $exitCode -eq 123 ]; then npm run start:serve; else test $exitCode -eq 0 || npm run _start:dev; fi",
    "_start:dev": "react-scripts start",
    "start:ci": "cross-env BROWSER=none CI=true HOST=0.0.0.0 PORT=$REACT_APP_PORT PORT=$PORT NODE_OPTIONS=--max-old-space-size=384 GENERATE_SOURCEMAP=${REACT_APP_ENABLE_SOURCE_MAPS:-false} react-scripts start",
    "start:lowmem": "cross-env BROWSER=none CI=true HOST=0.0.0.0 PORT=$REACT_APP_PORT PORT=$PORT NODE_OPTIONS=--max-old-space-size=256 GENERATE_SOURCEMAP=${REACT_APP_ENABLE_SOURCE_MAPS:-false} react-scripts start",
    "ci:dev": "npm run start:ci",
    "prebuild": "node scripts/copy-assets-to-public.js",
    "build": "react-scripts build",
    "build:ci": "cross-env CI=true NODE_OPTIONS=--max-old-space-size=256 GENERATE_SOURCEMAP=${REACT_APP_ENABLE_SOURCE_MAPS:-false} react-scripts build",
    "serve": "node -e \"const p=process.env.REACT_APP_PORT||process.env.PORT||3000;process.env.PORT=p;process.env.HOST=process.env.HOST||'0.0.0.0';require('child_process').spawn('npx',['serve','-s','build','-L','-n','-C','--single','-l',String(p)],{stdio:'inherit',shell:true});\"",
    "start:serve": "cross-env REACT_APP_ENABLE_SOURCE_MAPS=false node -e \"const p=process.env.REACT_APP_PORT||process.env.PORT||3000;process.env.REACT_APP_PORT=p;process.env.PORT=p;process.env.HOST=process.env.HOST||'0.0.0.0';const {spawnSync}=require('child_process');const r=spawnSync('npm',['run','build:ci'],{stdio:'inherit',shell:true});if((r.status||0)!==0)process.exit(r.status||1);require('child_process').spawn('npx',['serve','-s','build','-L','-n','-C','--single','-l',String(p)],{stdio:'inherit',shell:true});\"",
    "ci": "npm run start:serve",
    "healthcheck": "node -e \"const http=require('http');const port=process.env.REACT_APP_PORT||process.env.PORT||3000;const path=(process.env.REACT_APP_HEALTHCHECK_PATH)||'/';const opts={host:'127.0.0.1',port,path,timeout:5000};const req=http.get(opts,res=>{let data='';res.on('data',c=>data+=c);res.on('end',()=>{const okMeta=/x-healthcheck\\\" content=\\\"ok/.test(data);const statusOk=res.statusCode===200;console.log('health',res.statusCode, okMeta?'meta:ok':'meta:missing');process.exit(statusOk?0:1)});});req.on('timeout',()=>{console.error('healthcheck timeout');req.destroy();process.exit(1)});req.on('error',e=>{console.error(e.message);process.exit(1)});\"",
    "test": "cross-env CI=true react-scripts test --watchAll=false --passWithNoTests",
    "postinstall": "npx -y update-browserslist-db@latest || true",
    "eject": "react-scripts eject",
    "prestart": "echo \"INFO: In CI, 'npm run start:serve' is preferred to avoid exit code 137 (watch server). Using start script will auto-redirect when CI=true.\""
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
