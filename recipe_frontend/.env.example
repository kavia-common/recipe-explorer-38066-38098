# PUBLIC_INTERFACE
# Example environment variables for recipe_frontend
# Copy to .env and adjust values for your environment. Do NOT commit real secrets.

# Server bind configuration
HOST=0.0.0.0
REACT_APP_PORT=3000

# Healthcheck path (static probe)
REACT_APP_HEALTHCHECK_PATH=/health.html

# Logging and environment
REACT_APP_NODE_ENV=production
REACT_APP_LOG_LEVEL=info

# Feature flags
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false

# Source maps disabled by default to reduce memory in CI; set to true only if needed locally
REACT_APP_ENABLE_SOURCE_MAPS=false

# Networking and API endpoints (examples)
REACT_APP_API_BASE=http://localhost:8080/api
REACT_APP_BACKEND_URL=http://localhost:8080
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_WS_URL=ws://localhost:8080

# CI hints
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_TRUST_PROXY=true

# Note: the orchestrator will set CI=true in CI environments automatically.
