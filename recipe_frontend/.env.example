# PUBLIC_INTERFACE
# CI-safe defaults for recipe_frontend
# Copy this file to .env and adjust as needed for local development.
# In CI, the orchestrator will inject variables based on this template.

# Bind to all interfaces for container access
HOST=0.0.0.0

# Frontend port (also exported as PORT for CRA/dev-server parity)
REACT_APP_PORT=3000

# Disable source maps to reduce memory usage in CI
REACT_APP_ENABLE_SOURCE_MAPS=false

# Healthcheck path used by npm run healthcheck
REACT_APP_HEALTHCHECK_PATH=/health.html

# Optional: toggle features without changing code
REACT_APP_NODE_ENV=production
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info

# Backends (placeholders; orchestrator should set real endpoints)
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=
