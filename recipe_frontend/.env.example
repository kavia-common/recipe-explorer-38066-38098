# PUBLIC_INTERFACE
# Environment variables for recipe_frontend
# Copy this file to .env and adjust values for your environment.
# Do NOT commit real secrets.

# Base URLs (do not hardcode in code; injected by orchestrator in CI)
REACT_APP_API_BASE=http://localhost:8080/api
REACT_APP_BACKEND_URL=http://localhost:8080
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_WS_URL=ws://localhost:8080/ws

# Node/React flags
REACT_APP_NODE_ENV=production
REACT_APP_NEXT_TELEMETRY_DISABLED=1
# Disable source maps by default in CI to reduce memory; set to "true" to enable
REACT_APP_ENABLE_SOURCE_MAPS=false

# Server binding
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info

# Healthcheck path (static serve includes index.html on "/")
REACT_APP_HEALTHCHECK_PATH=/

# Features and experiments (comma-separated lists or JSON as your app expects)
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
