# PUBLIC_INTERFACE
# Example environment configuration for recipe_frontend.
# Copy to .env and fill in values as needed. Do not commit actual secrets.

# App URLs
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=

# Runtime environment
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1

# Performance toggles
# Disable source maps by default to reduce memory consumption in CI.
REACT_APP_ENABLE_SOURCE_MAPS=false

# Network binding and port
# In container/K8s environments, binding to 0.0.0.0 is often required.
HOST=0.0.0.0
REACT_APP_PORT=3000

# Proxy/trust & logging
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info

# Health and features
REACT_APP_HEALTHCHECK_PATH=/
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
