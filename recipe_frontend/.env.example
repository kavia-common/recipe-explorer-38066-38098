# PUBLIC_INTERFACE
# CI-safe defaults for recipe_frontend
# Copy to .env and adjust as needed. Orchestrator will set these in CI.

# Networking
HOST=0.0.0.0
REACT_APP_PORT=3000

# Build/Debug
REACT_APP_ENABLE_SOURCE_MAPS=false
CI=true
BROWSER=none

# Healthcheck
REACT_APP_HEALTHCHECK_PATH=/health.html

# App URLs (examples; set by orchestrator in real deployments)
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=
REACT_APP_NODE_ENV=production
REACT_APP_NEXT_TELEMETRY_DISABLED=true
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
