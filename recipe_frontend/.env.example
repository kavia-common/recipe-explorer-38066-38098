# PUBLIC_INTERFACE
# Example environment configuration for recipe_frontend
# Copy this file to .env and adjust values per environment.
# CI orchestrator will inject these as needed; do not commit actual secrets.

# Bind address and port
HOST=0.0.0.0
REACT_APP_PORT=3000

# Frontend/Backend URLs (examples; replace in actual .env)
REACT_APP_API_BASE=http://localhost:4000/api
REACT_APP_BACKEND_URL=http://localhost:4000
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_WS_URL=ws://localhost:4000/ws

# Node environment and telemetry flags
REACT_APP_NODE_ENV=production
REACT_APP_NEXT_TELEMETRY_DISABLED=1

# CI stability: disable source maps by default to reduce memory
REACT_APP_ENABLE_SOURCE_MAPS=false

# Trust proxy / logging
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info

# Healthcheck path for static probe
REACT_APP_HEALTHCHECK_PATH=/health.html

# Feature flags
REACT_APP_FEATURE_FLAGS={}
REACT_APP_EXPERIMENTS_ENABLED=false
