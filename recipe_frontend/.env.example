# PUBLIC INTERFACE
# Example environment variables for recipe_frontend.
# Copy this file to .env and adjust values for your environment.
# Do NOT commit real .env with secrets.

# Base URLs and API endpoints
REACT_APP_API_BASE=https://api.example.com
REACT_APP_BACKEND_URL=https://backend.example.com
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_WS_URL=ws://localhost:3000

# Runtime environment flags
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1

# Source maps (disable by default to reduce memory in CI)
REACT_APP_ENABLE_SOURCE_MAPS=false

# Server binding and port
# Some orchestrators require 0.0.0.0 to be reachable across containers.
HOST=0.0.0.0
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=true

# Logging and healthcheck
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/healthz

# Feature flags
REACT_APP_FEATURE_FLAGS={}
REACT_APP_EXPERIMENTS_ENABLED=false
