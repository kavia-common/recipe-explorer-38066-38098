# PUBLIC_INTERFACE
# Environment sample for recipe_frontend
# Copy to .env and adjust for your environment. Do NOT commit real secrets.

# Core app URLs (used by frontend to call backend and compose links)
REACT_APP_API_BASE=http://localhost:8080/api
REACT_APP_BACKEND_URL=http://localhost:8080
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_WS_URL=ws://localhost:8080

# Node/telemetry flags
REACT_APP_NODE_ENV=production
REACT_APP_NEXT_TELEMETRY_DISABLED=true

# Disable source maps by default to reduce memory in CI.
# Set to "true" only when you actively need source maps.
REACT_APP_ENABLE_SOURCE_MAPS=false

# Network settings
REACT_APP_PORT=3000
HOST=0.0.0.0

# Proxy and logging
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info

# Healthcheck path (static page, low-memory)
REACT_APP_HEALTHCHECK_PATH=/health.html

# Feature flags / experiments (comma-separated list or JSON as your app needs)
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
