# Example environment variables for recipe_frontend
# Copy this file to .env and fill values as needed. Do NOT commit a real .env file.

# Networking
HOST=0.0.0.0
REACT_APP_PORT=3000
REACT_APP_HEALTHCHECK_PATH=/

# Build and debugging
# Set to true only if you need source maps (consumes more memory)
REACT_APP_ENABLE_SOURCE_MAPS=false
REACT_APP_NODE_ENV=development

# URLs
REACT_APP_API_BASE=http://localhost:4000/api
REACT_APP_BACKEND_URL=http://localhost:4000
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_WS_URL=ws://localhost:4000/ws

# Operational flags
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info
REACT_APP_FEATURE_FLAGS={}
REACT_APP_EXPERIMENTS_ENABLED=false

# Note:
# - In CI/orchestrated environments, prefer `npm run start:serve` which builds and serves statically.
# - For hot reload development, use `npm start` locally only.
