# PUBLIC_INTERFACE
# Example environment configuration for recipe_frontend
# Copy to .env and adjust as needed; do not commit secrets.

# Base URLs
REACT_APP_API_BASE=http://localhost:8080/api
REACT_APP_BACKEND_URL=http://localhost:8080
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_WS_URL=ws://localhost:8080/ws

# Environment
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1

# Build/serve toggles
REACT_APP_ENABLE_SOURCE_MAPS=false
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false

# For local dev you may set:
# HOST=0.0.0.0
# PORT=3000
