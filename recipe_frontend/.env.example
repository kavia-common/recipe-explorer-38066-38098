# PUBLIC_INTERFACE
# Example environment configuration for recipe_frontend.
# Copy to .env and adjust as needed. Do not commit real secrets.

# Server bind config
REACT_APP_PORT=3000
HOST=0.0.0.0

# Feature flags
REACT_APP_ENABLE_SOURCE_MAPS=false
REACT_APP_NODE_ENV=production
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/health.html
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false

# URLs (if needed by frontend)
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=

# Next telemetry (not used but included to mirror orchestrator env list)
REACT_APP_NEXT_TELEMETRY_DISABLED=true
