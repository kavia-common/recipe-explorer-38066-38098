# PUBLIC_INTERFACE
# Example environment variables for recipe_frontend container.
# Copy to .env and adjust values as needed. Do NOT commit real secrets.

# Base URLs
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=

# Runtime behavior
REACT_APP_NODE_ENV=production
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=false

# Server binding
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=true
REACT_APP_HEALTHCHECK_PATH=/

# Logging and flags
REACT_APP_LOG_LEVEL=info
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
