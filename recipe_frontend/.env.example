# PUBLIC_INTERFACE
# Example environment for recipe_frontend (CI-safe defaults)
HOST=0.0.0.0
REACT_APP_PORT=3000
PORT=3000

# Disable source maps in CI to reduce memory
REACT_APP_ENABLE_SOURCE_MAPS=false
GENERATE_SOURCEMAP=false

# Healthcheck path used by npm run healthcheck
REACT_APP_HEALTHCHECK_PATH=/health.html

# Log level and basic flags
REACT_APP_LOG_LEVEL=info
REACT_APP_TRUST_PROXY=true
REACT_APP_NODE_ENV=production
REACT_APP_NEXT_TELEMETRY_DISABLED=1

# Feature flags (example)
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=

# External endpoints (set by orchestrator as appropriate)
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=
