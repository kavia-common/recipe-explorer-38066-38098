# PUBLIC_INTERFACE
# Example environment variables for recipe_frontend.
# Copy this file to .env and adjust values for your environment.
# Do not commit .env files with secrets.

# Server and runtime
REACT_APP_PORT=3000
HOST=0.0.0.0
REACT_APP_NODE_ENV=development

# Feature flags
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false

# Logging and health
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/

# API endpoints (adjust according to your backend)
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=

# Disable telemetry/analytics in CI by default
REACT_APP_NEXT_TELEMETRY_DISABLED=true

# Important: Disable source maps by default to avoid source-map-loader overhead and instability
# Set to "true" only if you explicitly need source maps locally.
REACT_APP_ENABLE_SOURCE_MAPS=false
GENERATE_SOURCEMAP=false

# Trust proxy if needed by your environment (e.g., reverse proxy)
REACT_APP_TRUST_PROXY=false
