# PUBLIC_INTERFACE
# Environment configuration for recipe_frontend
# Copy to .env and adjust values for your environment.

# URLs and API endpoints
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=

# Environment and telemetry
REACT_APP_NODE_ENV=production
REACT_APP_NEXT_TELEMETRY_DISABLED=true

# Source maps (disabled by default for CI stability)
REACT_APP_ENABLE_SOURCE_MAPS=false

# Server binding
REACT_APP_PORT=3000
HOST=0.0.0.0

# Network/security
REACT_APP_TRUST_PROXY=true

# Logging level
REACT_APP_LOG_LEVEL=info

# Healthcheck path (used by npm run healthcheck)
REACT_APP_HEALTHCHECK_PATH=/health.html

# Feature flags
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
