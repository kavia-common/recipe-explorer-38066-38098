# PUBLIC_INTERFACE
# Example environment configuration for recipe_frontend
# Copy this file to .env and adjust values as needed for your environment.

# Core app endpoints (do not hardcode in code; read from env)
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=

# Environment and build toggles
REACT_APP_NODE_ENV=production
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=false

# Server/serve configuration
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/

# Feature flags
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false

# Note:
# - For CI/non-interactive runs prefer: npm run start:serve
# - To bind to all interfaces in container environments set HOST=0.0.0.0 in your process manager.
