# PUBLIC_INTERFACE
# Example environment variables for recipe_frontend (CI-safe)
# Copy this file to .env and adjust as needed for local development.

# Bind to all interfaces (container friendly)
HOST=0.0.0.0

# Port for the frontend (overridden by orchestrator if provided)
REACT_APP_PORT=3000

# Disable source maps in CI by default to reduce memory
REACT_APP_ENABLE_SOURCE_MAPS=false

# Healthcheck path (static)
REACT_APP_HEALTHCHECK_PATH=/health.html

# Optional feature flags
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=
REACT_APP_NODE_ENV=production
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
