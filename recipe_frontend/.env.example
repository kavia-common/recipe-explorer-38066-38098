# PUBLIC_INTERFACE
# Example environment variables for recipe_frontend
# Copy this file to .env and adjust values for your environment. Do not commit real secrets.

# App endpoints
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=

# Runtime environment
REACT_APP_NODE_ENV=production
REACT_APP_NEXT_TELEMETRY_DISABLED=1

# Build/serve options
REACT_APP_ENABLE_SOURCE_MAPS=false
REACT_APP_PORT=3000
HOST=0.0.0.0

# Misc
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/health.html
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
