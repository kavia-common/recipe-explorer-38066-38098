# PUBLIC_INTERFACE
# CI-safe defaults for recipe_frontend

# Bind to all interfaces for container networking
HOST=0.0.0.0

# Default port for the app
REACT_APP_PORT=3000

# Disable source maps in CI to reduce memory
REACT_APP_ENABLE_SOURCE_MAPS=false

# Optional: Explicit healthcheck path (defaults to /health.html)
# REACT_APP_HEALTHCHECK_PATH=/health.html

# Runtime configurable variables (provided by orchestrator)
# REACT_APP_API_BASE=
# REACT_APP_BACKEND_URL=
# REACT_APP_FRONTEND_URL=
# REACT_APP_WS_URL=
# REACT_APP_NODE_ENV=production
# REACT_APP_NEXT_TELEMETRY_DISABLED=1
# REACT_APP_TRUST_PROXY=true
# REACT_APP_LOG_LEVEL=info
# REACT_APP_FEATURE_FLAGS=
# REACT_APP_EXPERIMENTS_ENABLED=false
