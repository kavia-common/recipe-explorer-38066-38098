# PUBLIC_INTERFACE
# Example environment configuration for recipe_frontend
# Copy to .env and adjust as needed. Do NOT commit real secrets.

# Core service URLs (do not hardcode; orchestrator will inject for CI)
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=

# Behavior flags
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=true

# Source maps are disabled by default for CI stability and low memory
# Set to true only if you need source maps locally
REACT_APP_ENABLE_SOURCE_MAPS=false

# Network and port configuration
# Expose the server on all interfaces for containerized runs
HOST=0.0.0.0
# Preferred port (orchestrator may override). Used by dev server and static serve
REACT_APP_PORT=3000

# Trust proxy headers if running behind reverse proxy (optional)
REACT_APP_TRUST_PROXY=true

# Logging level (debug|info|warn|error)
REACT_APP_LOG_LEVEL=info

# Healthcheck path (static) used by scripts/healthcheck
# health.html exists under public/ and includes <meta name="x-healthcheck" content="ok">
REACT_APP_HEALTHCHECK_PATH=/health.html

# Feature flags and experiments (JSON-encoded or comma-separated)
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
