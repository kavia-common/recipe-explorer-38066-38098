# PUBLIC_INTERFACE
# Environment variables for recipe_frontend
# Copy to .env and adjust as needed (do not commit secrets)

# Networking
REACT_APP_PORT=3000
HOST=0.0.0.0

# Feature flags and logging
REACT_APP_LOG_LEVEL=info
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false

# Source maps (disabled by default to reduce memory)
REACT_APP_ENABLE_SOURCE_MAPS=false

# Healthcheck path (static)
REACT_APP_HEALTHCHECK_PATH=/health.html

# API endpoints (example placeholders)
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=

# Node environment
REACT_APP_NODE_ENV=production
REACT_APP_NEXT_TELEMETRY_DISABLED=1

# Proxy/trust (if behind reverse proxy)
REACT_APP_TRUST_PROXY=true
