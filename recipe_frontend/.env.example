# PUBLIC_INTERFACE
# Example environment configuration for recipe_frontend (CI-safe defaults)
# Copy this file to .env and adjust values per environment as needed.

# Bind to all interfaces in containers
HOST=0.0.0.0

# Default port (override via orchestrator if needed)
REACT_APP_PORT=3000
PORT=3000

# Disable source maps by default in CI to reduce memory
REACT_APP_ENABLE_SOURCE_MAPS=false
GENERATE_SOURCEMAP=false

# Healthcheck path (static) used by healthcheck script
REACT_APP_HEALTHCHECK_PATH=/health.html

# Optional logging and flags
REACT_APP_LOG_LEVEL=info
REACT_APP_TRUST_PROXY=true

# Optional feature flags
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false

# Node memory cap for CI safety (scripts may override)
# NODE_OPTIONS=--max-old-space-size=160

# External endpoints (configure per environment; do not hardcode)
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=
REACT_APP_NODE_ENV=production
REACT_APP_NEXT_TELEMETRY_DISABLED=1
