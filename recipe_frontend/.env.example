# PUBLIC_INTERFACE
# Example environment variables for recipe_frontend React app.
# Copy to .env and adjust values per environment. Do not commit secrets.

# API/Service endpoints
REACT_APP_API_BASE=http://localhost:4000/api
REACT_APP_BACKEND_URL=http://localhost:4000
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_WS_URL=ws://localhost:4000/ws

# Runtime flags
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=false

# Server binding and logging
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/

# Features
REACT_APP_FEATURE_FLAGS={}
REACT_APP_EXPERIMENTS_ENABLED=false

# Note: HOST is controlled by scripts (0.0.0.0 for container). Set only if needed.
# HOST=0.0.0.0
