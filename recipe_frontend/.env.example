# PUBLIC_INTERFACE
# Sample environment variables for recipe_frontend
# Copy this file to .env and adjust values per environment.
# IMPORTANT: Do not commit your .env with secrets.

# Application endpoints (do not hardcode in code)
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=

# App runtime toggles
REACT_APP_NODE_ENV=production
REACT_APP_NEXT_TELEMETRY_DISABLED=1
# Disable source maps in CI to save memory; set to "true" only if required for debugging
REACT_APP_ENABLE_SOURCE_MAPS=false

# Networking
# Preferred for CI and containerized runs
REACT_APP_PORT=3000
# If your platform needs explicit host, set HOST=0.0.0.0 in the process environment

# Reverse proxy / security toggles (optional)
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info

# Healthcheck path used by npm run healthcheck (defaults to "/")
REACT_APP_HEALTHCHECK_PATH=/

# Feature flags
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
