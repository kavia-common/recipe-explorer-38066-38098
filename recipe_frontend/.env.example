# PUBLIC_INTERFACE
# Example environment configuration for recipe_frontend
# Copy to .env and adjust values for your environment. Do not commit secrets.

# Server binding
REACT_APP_PORT=3000
HOST=0.0.0.0

# Feature flags
REACT_APP_ENABLE_SOURCE_MAPS=false
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/health.html
REACT_APP_FEATURE_FLAGS={}
REACT_APP_EXPERIMENTS_ENABLED=false

# External endpoints (adjust to your deployment)
REACT_APP_API_BASE=http://localhost:8080/api
REACT_APP_BACKEND_URL=http://localhost:8080
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_WS_URL=ws://localhost:8080/ws
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
