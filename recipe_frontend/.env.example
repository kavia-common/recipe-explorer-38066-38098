# PUBLIC_INTERFACE
# Recipe Frontend environment example.
# Copy to .env and adjust values as needed. Do not commit actual secrets.

# Networking
REACT_APP_PORT=3000
HOST=0.0.0.0

# API endpoints
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=

# Runtime toggles
REACT_APP_NODE_ENV=production
REACT_APP_NEXT_TELEMETRY_DISABLED=true
# Disable source maps by default to reduce memory in CI; set to 'true' locally if needed
REACT_APP_ENABLE_SOURCE_MAPS=false

# Proxy/logging
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info

# Healthcheck
# Default probes: /health.html or / (index with meta)
REACT_APP_HEALTHCHECK_PATH=/health.html

# Feature flags
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
