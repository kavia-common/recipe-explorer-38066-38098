# PUBLIC_INTERFACE
# Example environment variables for recipe_frontend
# Copy this file to .env and adjust values for your environment.

# App endpoints (do not hardcode; orchestrator injects real values)
REACT_APP_API_BASE=http://localhost:8080/api
REACT_APP_BACKEND_URL=http://localhost:8080
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_WS_URL=ws://localhost:8080/ws

# Node/React behavior
REACT_APP_NODE_ENV=production
REACT_APP_NEXT_TELEMETRY_DISABLED=true

# Source maps disabled by default to reduce CI memory
REACT_APP_ENABLE_SOURCE_MAPS=false

# Network binding
REACT_APP_PORT=3000
HOST=0.0.0.0

# Proxy/trust and logging
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info

# Healthcheck path (root by default)
REACT_APP_HEALTHCHECK_PATH=/

# Feature flags
REACT_APP_FEATURE_FLAGS={}
REACT_APP_EXPERIMENTS_ENABLED=false
