# PUBLIC_INTERFACE
# Example environment configuration for recipe_frontend (CI-safe defaults)
# Copy this to .env and adjust values as needed. Do NOT commit real secrets.

# Networking
HOST=0.0.0.0
REACT_APP_PORT=3000

# App environment
REACT_APP_NODE_ENV=production
REACT_APP_ENABLE_SOURCE_MAPS=false
REACT_APP_HEALTHCHECK_PATH=/health.html

# URLs (configure per environment)
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info

# Feature flags
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false

# CI note:
# In CI, npm start auto-redirects to `npm run start:serve` which builds and serves statically.
# Prefer using: npm --prefix recipe_frontend run start:serve
