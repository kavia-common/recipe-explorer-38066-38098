# PUBLIC_INTERFACE
# Example environment variables for recipe_frontend (CI-safe defaults)
# Copy this file to .env and adjust as needed. Do not commit your real .env.

# Bind address and port
HOST=0.0.0.0
REACT_APP_PORT=3000

# Healthcheck path used by npm run healthcheck
REACT_APP_HEALTHCHECK_PATH=/health.html

# Disable source maps by default in CI to reduce memory
REACT_APP_ENABLE_SOURCE_MAPS=false

# App environment and URLs (set by orchestrator in real deployments)
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=

# Other toggles
REACT_APP_NODE_ENV=production
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
