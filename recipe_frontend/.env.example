# PUBLIC_INTERFACE
# Example environment configuration for recipe_frontend.
# Copy to .env and adjust values for your environment.
# Do NOT commit secrets.

# Base URLs
REACT_APP_API_BASE=http://localhost:8080/api
REACT_APP_BACKEND_URL=http://localhost:8080
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_WS_URL=ws://localhost:8080

# Environment/flags
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=false
REACT_APP_FEATURE_FLAGS={}
REACT_APP_EXPERIMENTS_ENABLED=false

# Server/serve settings
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/

# Note:
# - In CI, prefer `npm run start:serve` which builds and serves statically on REACT_APP_PORT.
# - For hot reload in constrained CI, use `npm run start:ci` or `npm run start:lowmem`.
# - Avoid using `npm start` in CI; the watch server can be killed by orchestrators (exit 137).
