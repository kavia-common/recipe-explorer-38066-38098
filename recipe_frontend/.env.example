# PUBLIC_INTERFACE
# Environment variables for recipe_frontend (copy to .env for local usage)
# Do not commit real secrets. CI orchestrator injects these at runtime.

# App endpoints
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=

# Environment flags
REACT_APP_NODE_ENV=production
REACT_APP_NEXT_TELEMETRY_DISABLED=true
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false

# Source maps (disabled by default for CI stability)
REACT_APP_ENABLE_SOURCE_MAPS=false
GENERATE_SOURCEMAP=false

# Server bind info
REACT_APP_PORT=3000
HOST=0.0.0.0

# Reverse proxy / trust / logging
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info

# Healthcheck path (static page served without booting React)
REACT_APP_HEALTHCHECK_PATH=/health.html
