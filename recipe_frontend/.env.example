# Example environment variables for recipe_frontend
# Copy to .env and adjust values as needed. Do not commit real secrets.

# Base URLs
REACT_APP_API_BASE=https://api.example.com
REACT_APP_BACKEND_URL=https://api.example.com
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_WS_URL=ws://localhost:3000/ws

# Runtime behavior
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=false

# Server ports and network
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false

# Logging and flags
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/
REACT_APP_FEATURE_FLAGS={}
REACT_APP_EXPERIMENTS_ENABLED=false

# Host binding (set by scripts when needed)
# HOST=0.0.0.0
