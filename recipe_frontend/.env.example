# PUBLIC_INTERFACE
# Example environment variables for recipe_frontend. Do not commit actual .env with secrets.

# Core app endpoints (set by orchestrator)
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=

# Runtime and telemetry
REACT_APP_NODE_ENV=production
REACT_APP_NEXT_TELEMETRY_DISABLED=true

# Source maps disabled by default to reduce memory usage in CI
REACT_APP_ENABLE_SOURCE_MAPS=false
GENERATE_SOURCEMAP=false

# Networking
REACT_APP_PORT=3000
HOST=0.0.0.0
REACT_APP_TRUST_PROXY=true

# Logging and features
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/health.html
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
