# PUBLIC_INTERFACE
# Environment configuration for recipe_frontend
# Copy this file to .env and adjust values per environment.

# Core app endpoints (do not hardcode secrets here)
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=

# App behavior flags
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=true
REACT_APP_ENABLE_SOURCE_MAPS=false
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false

# Server/network
# Preferred port for both dev and static serve
REACT_APP_PORT=3000
# Bind to all interfaces when containerized
HOST=0.0.0.0
# Trust proxy headers if behind reverse proxy
REACT_APP_TRUST_PROXY=true

# Logging
REACT_APP_LOG_LEVEL=info

# Health endpoint path used by healthcheck script (fallback to "/" if missing)
REACT_APP_HEALTHCHECK_PATH=/health.html
